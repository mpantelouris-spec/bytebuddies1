{
  "name": "bytebuddies",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/build-universal-hex.mjs && node scripts/build-boot-hex.mjs && vite",
    "build": "node scripts/build-universal-hex.mjs && node scripts/build-boot-hex.mjs && node scripts/build-bluetooth-hex.mjs && vite build",
    "build:boot-hex": "node scripts/build-boot-hex.mjs",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:dev": "ELECTRON_START_URL=http://localhost:5173 electron .",
    "build:ble-hex": "node scripts/build-bluetooth-hex.mjs",
    "build:makecode-ble": "cd ble_compile && npx makecode build && cp built/binary.hex ../public/microbit-v2-cutebot-ble.hex",
    "dev:hex": "node build-hex-server.mjs",
    "smoke:game-builder": "node scripts/game-builder-smoke.mjs",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.17",
    "@microbit/microbit-fs": "^0.10.0",
    "@microbit/microbit-universal-hex": "^0.2.2",
    "@monaco-editor/react": "^4.6.0",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "blockly": "^10.0.0",
    "dapjs": "^2.3.0",
    "firebase": "^12.11.0",
    "jsqr": "^1.4.0",
    "microbit-web-bluetooth": "^0.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "babel-jest": "^30.4.1",
    "electron": "^33.2.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "vite": "^5.0.0"
  }
}
