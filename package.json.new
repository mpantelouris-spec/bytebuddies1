{
  "name": "bytebuddies-complete",
  "version": "2.0.0",
  "description": "Complete ByteBuddies platform with ML, Hardware, Cloud, and Advanced Effects",
  "type": "module",
  "main": "src/index.jsx",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "@tensorflow/tfjs": "^4.2.0",
    "@tensorflow/tfjs-backend-webgl": "^4.2.0",
    "@tensorflow/tfjs-backend-cpu": "^4.2.0",
    "firebase": "^10.1.0",
    "paho-mqtt": "^1.0.1",
    "openai": "^4.3.0",
    "axios": "^1.3.0",
    "blockly": "^10.0.0",
    "@google-blockly/block-shareable-procedures": "^2.0.0",
    "zustand": "^4.3.0",
    "date-fns": "^2.29.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^3.1.0",
    "vite": "^4.1.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/jest-dom": "^5.16.5",
    "jest": "^29.4.0",
    "prettier": "^2.8.3",
    "eslint": "^8.32.0",
    "eslint-plugin-react": "^7.32.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:ml": "jest --testPathPattern=mlTraining",
    "test:hardware": "jest --testPathPattern=hardwareCommunication",
    "test:cloud": "jest --testPathPattern=cloudBackend",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
