rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /classes/{classId} {
      allow read, write: if true;
    }
    match /assignments/{assignmentId} {
      allow read, write: if true;
      match /submissions/{submissionId} {
        allow read, write: if true;
        match /submissions/{submissionId} {
          allow read, write: if true;
        }
      }
    }

    match /licenses/{licenseEmail} {
      allow get: if request.auth != null
        && (
          request.auth.token.email.lower() in ['mpantelouris@britishschool.sch.ae', 'fudoh@britishschool.sch.ae']
          || licenseEmail == request.auth.token.email.lower()
        );
      allow list: if request.auth != null
        && request.auth.token.email.lower() in ['mpantelouris@britishschool.sch.ae', 'fudoh@britishschool.sch.ae'];

      allow create: if request.auth != null && (
        (
          request.auth.token.email.lower() in ['mpantelouris@britishschool.sch.ae', 'fudoh@britishschool.sch.ae']
          && request.resource.data.email == licenseEmail
          && request.resource.data.status in ['active', 'suspended']
        ) || (
          request.resource.data.keys().hasOnly(['email', 'role', 'status', 'organization', 'teacherEmail', 'expiresAt', 'updatedAt', 'createdAt'])
          && request.resource.data.keys().hasAll(['email', 'role', 'status', 'organization', 'teacherEmail', 'expiresAt', 'updatedAt', 'createdAt'])
          && request.resource.data.email == licenseEmail
          && request.resource.data.role == 'student'
          && request.resource.data.status == 'active'
          && request.resource.data.teacherEmail is string
          && request.auth.token.email.lower() == request.resource.data.teacherEmail.lower()
          && getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.teacherEmail)).data.role == 'teacher'
          && getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.teacherEmail)).data.status == 'active'
          && getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.teacherEmail)).data.studentLimit is int
          && getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.teacherEmail)).data.pupilEmails is list
          && getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.teacherEmail)).data.pupilEmails.hasAny([licenseEmail])
          && getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.teacherEmail)).data.pupilEmails.size() <= getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.teacherEmail)).data.studentLimit
          && request.resource.data.organization == getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.teacherEmail)).data.organization
          && request.resource.data.expiresAt == getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.teacherEmail)).data.expiresAt
        )
      );
      allow update: if request.auth != null && (
        (
          request.auth.token.email.lower() in ['mpantelouris@britishschool.sch.ae', 'fudoh@britishschool.sch.ae']
          && request.resource.data.email == licenseEmail
          && request.resource.data.status in ['active', 'suspended']
        ) || (
          resource.data.role == 'student'
          && resource.data.status == 'active'
          && resource.data.teacherEmail == request.auth.token.email.lower()
          && request.resource.data.keys().hasOnly(['email', 'role', 'status', 'organization', 'teacherEmail', 'expiresAt', 'updatedAt', 'createdAt'])
          && request.resource.data.email == licenseEmail
          && request.resource.data.role == 'student'
          && request.resource.data.status == 'active'
          && request.resource.data.teacherEmail == resource.data.teacherEmail
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'createdAt'])
          && getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.teacherEmail)).data.role == 'teacher'
          && getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.teacherEmail)).data.status == 'active'
          && getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.teacherEmail)).data.pupilEmails.hasAny([licenseEmail])
          && getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.teacherEmail)).data.pupilEmails.size() <= getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.teacherEmail)).data.studentLimit
          && request.resource.data.organization == getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.teacherEmail)).data.organization
          && request.resource.data.expiresAt == getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.teacherEmail)).data.expiresAt
        ) || (
          licenseEmail == request.auth.token.email.lower()
          && resource.data.role == 'teacher'
          && resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pupilEmails', 'updatedAt'])
          && request.resource.data.pupilEmails is list
          && request.resource.data.pupilEmails.size() <= resource.data.studentLimit
          && request.resource.data.pupilEmails.hasAll(resource.data.get('pupilEmails', []))
        )
      );
      allow delete: if false;
    }

    // ByteBuddies community project sharing. Browsing is for signed-in app users.
    match /communityProjects/{projectId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['id', 'title', 'description', 'author', 'type', 'preview', 'likes', 'views', 'remixes', 'ownerUid', 'createdAt'])
        && request.resource.data.keys().hasAll(['id', 'title', 'description', 'author', 'type', 'preview', 'likes', 'views', 'remixes', 'ownerUid', 'createdAt'])
        && request.resource.data.id == projectId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 48
        && request.resource.data.description is string && request.resource.data.description.size() <= 220
        && request.resource.data.author is string && request.resource.data.author.size() > 0 && request.resource.data.author.size() <= 24
        && request.resource.data.type == 'game'
        && request.resource.data.preview is string && request.resource.data.preview.size() <= 12
        && request.resource.data.likes == 0
        && request.resource.data.views == 0
        && request.resource.data.remixes == 0
        && request.resource.data.createdAt is string;
      allow update: if request.auth != null && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && request.resource.data.views == resource.data.views + 1)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remixes'])
          && request.resource.data.remixes == resource.data.remixes + 1)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
          && request.resource.data.likes == request.resource.data.likedBy.size()
          && (
            (request.resource.data.likedBy.size() == resource.data.get('likedBy', []).size() + 1
              && request.resource.data.likedBy.hasAll(resource.data.get('likedBy', []))
              && request.resource.data.likedBy.hasAny([request.auth.uid]))
            || (resource.data.get('likedBy', []).size() == request.resource.data.likedBy.size() + 1
              && resource.data.get('likedBy', []).hasAll(request.resource.data.likedBy)
              && resource.data.get('likedBy', []).hasAny([request.auth.uid])
              && !request.resource.data.likedBy.hasAny([request.auth.uid]))
          ))
      );
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /data/project {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && get(/databases/$(database)/documents/communityProjects/$(projectId)).data.ownerUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['payload', 'encoding'])
          && request.resource.data.keys().hasAll(['payload', 'encoding'])
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 870400
          && request.resource.data.encoding in ['gzip-base64', 'json'];
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/communityProjects/$(projectId)).data.ownerUid == request.auth.uid;
      }
    }
  }
}
